<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <description>Auto-routes new claims to appropriate queue based on policy type</description>
    <label>Claim_Routing_Flow</label>
    <processType>AutoLaunchedFlow</processType>
    <trigger>
        <object>Claim__c</object>
        <type>RecordAfterSave</type>
        <conditions>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <field>IsNew</field>
                <operator>Equals</operator>
                <value>
                    <booleanValue>true</booleanValue>
                </value>
            </conditions>
        </conditions>
    </trigger>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Policy_RT</targetReference>
        </connector>
    </start>
    <recordLookups>
        <name>Get_Policy_RT</name>
        <label>Get_Policy_RT</label>
        <locationX>200</locationX>
        <locationY>50</locationY>
        <object>Policy__c</object>
        <connector>
            <targetReference>Route_by_Policy_Type</targetReference>
        </connector>
        <filters>
            <field>Id</field>
            <operator>Equals</operator>
            <value>
                <elementReference>$Record.Policy__c</elementReference>
            </value>
        </filters>
        <storeOutput>
            <outputReference>varPolicyRTName</outputReference>
            <field>RecordType.DeveloperName</field>
        </storeOutput>
    </recordLookups>
    <decisions>
        <name>Route_by_Policy_Type</name>
        <label>Route by Policy Type</label>
        <locationX>380</locationX>
        <locationY>50</locationY>
        <defaultConnector>
            <targetReference>Assign_to_Life_Queue</targetReference>
        </defaultConnector>
        <rules>
            <name>Auto_Claim_Route</name>
            <label>Auto Claim Route</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <field>varPolicyRTName</field>
                <operator>Equal</operator>
                <value>
                    <stringValue>Auto</stringValue>
                </value>
            </conditions>
            <connector>
                <targetReference>Assign_to_Auto_Queue</targetReference>
            </connector>
        </rules>
        <rules>
            <name>Property_Claim_Route</name>
            <label>Property Claim Route</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <field>varPolicyRTName</field>
                <operator>Equal</operator>
                <value>
                    <stringValue>Property</stringValue>
                </value>
            </conditions>
            <connector>
                <targetReference>Assign_to_Property_Queue</targetReference>
            </connector>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Assign_to_Auto_Queue</name>
        <label>Assign to Auto Queue</label>
        <locationX>560</locationX>
        <locationY>50</locationY>
        <object>Claim__c</object>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <stringValue>AUTO_QUEUE_ID_PLACEHOLDER</stringValue>
            </value>
        </inputAssignments>
        <filters>
            <field>Id</field>
            <operator>Equals</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
    </recordUpdates>
    <recordUpdates>
        <name>Assign_to_Property_Queue</name>
        <label>Assign to Property Queue</label>
        <locationX>560</locationX>
        <locationY>170</locationY>
        <object>Claim__c</object>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <stringValue>PROPERTY_QUEUE_ID_PLACEHOLDER</stringValue>
            </value>
        </inputAssignments>
        <filters>
            <field>Id</field>
            <operator>Equals</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
    </recordUpdates>
    <recordUpdates>
        <name>Assign_to_Life_Queue</name>
        <label>Assign to Life Queue</label>
        <locationX>560</locationX>
        <locationY>290</locationY>
        <object>Claim__c</object>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <stringValue>LIFE_QUEUE_ID_PLACEHOLDER</stringValue>
            </value>
        </inputAssignments>
        <filters>
            <field>Id</field>
            <operator>Equals</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
    </recordUpdates>
    <variables>
        <name>varPolicyRTName</name>
        <dataType>String</dataType>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <status>Active</status>
</Flow>