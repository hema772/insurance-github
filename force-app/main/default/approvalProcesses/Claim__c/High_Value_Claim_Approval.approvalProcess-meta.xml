<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>High Value Claim Approval</label>
    <description>Routes high-value claims (>$50,000) to Senior Adjuster then Department Manager</description>
    <active>true</active>
    <entryCriteria>
        <criteriaItems>
            <field>Claim__c.Claim_Amount__c</field>
            <operation>greaterThan</operation>
            <value>50000</value>
        </criteriaItems>
    </entryCriteria>
    <recordEditability>AdminOnly</recordEditability>
    <approvalPageFields>
        <field>Claim__c.Name</field>
        <field>Claim__c.OwnerId</field>
        <field>Claim__c.Claim_Amount__c</field>
        <field>Claim__c.Adjuster__c</field>
        <field>Claim__c.Policy__c</field>
    </approvalPageFields>
    <initialSubmissionActions>
        <fieldUpdates>
            <name>Update_Status_Submitted</name>
            <field>Claim__c.Approval_Status__c</field>
            <value>Submitted for Approval</value>
        </fieldUpdates>
    </initialSubmissionActions>
    <finalApprovalActions>
        <fieldUpdates>
            <name>Update_Status_Approved</name>
            <field>Claim__c.Approval_Status__c</field>
            <value>Approved</value>
        </fieldUpdates>
    </finalApprovalActions>
    <finalRejectionActions>
        <fieldUpdates>
            <name>Update_Status_Rejected</name>
            <field>Claim__c.Approval_Status__c</field>
            <value>Rejected</value>
        </fieldUpdates>
    </finalRejectionActions>
    <steps>
        <name>Step1_Senior_Adjuster</name>
        <label>Step1 Senior Adjuster</label>
        <stepNumber>1</stepNumber>
        <criteriaItems>
            <field>Claim__c.Id</field>
            <operation>notEqualTo</operation>
            <value>null</value>
        </criteriaItems>
        <approver>
            <type>User</type>
            <value>SENIOR_ADJUSTER_USER_ID_PLACEHOLDER</value>
        </approver>
        <responseType>FirstResponse</responseType>
    </steps>
    <steps>
        <name>Step2_Manager_Review</name>
        <label>Step2 Manager Review</label>
        <stepNumber>2</stepNumber>
        <criteriaItems>
            <field>Claim__c.Id</field>
            <operation>notEqualTo</operation>
            <value>null</value>
        </criteriaItems>
        <approver>
            <type>User</type>
            <value>DEPARTMENT_MANAGER_USER_ID_PLACEHOLDER</value>
        </approver>
        <responseType>FirstResponse</responseType>
        <rejectionBehavior>RejectAll</rejectionBehavior>
    </steps>
    <submitters>
        <type>Owner</type>
    </submitters>
</ApprovalProcess>